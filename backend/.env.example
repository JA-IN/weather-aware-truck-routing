# Django backend environment variables (copy to backend/.env)

# Use the same Postgres instance as the Next.js app, or point to your own DB.
# Django will create its own tables (django_trip_requests, django_route_analyses)
# so it will not collide with the Next.js/Drizzle tables.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# If not set, falls back to sqlite:///backend/db.sqlite3

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Comma separated list of allowed origins for the React/Next.js frontend.
# Example: https://your-frontend.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
